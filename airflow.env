# Airflow settings for this project. Load with:  source airflow.env
# No passwords here: the PostgreSQL password comes from ~/.pgpass

export AIRFLOW_HOME="$HOME/airflow"                                   # Airflow's own files (logs, config)
export AIRFLOW__CORE__DAGS_FOLDER="$HOME/project3-nse-pipeline/dags"  # where our pipeline lives
export AIRFLOW__CORE__LOAD_EXAMPLES=False                             # don't load ~50 example DAGs
export AIRFLOW__CORE__DEFAULT_TIMEZONE=Asia/Kolkata                   # schedules in IST
export AIRFLOW__CORE__EXECUTOR=LocalExecutor                          # run tasks as local processes
export AIRFLOW__CORE__PARALLELISM=2                                   # matches the 2 CPU threads given to WSL
export AIRFLOW__DATABASE__SQL_ALCHEMY_CONN="postgresql+psycopg2://postgres@localhost:5432/airflow_meta"